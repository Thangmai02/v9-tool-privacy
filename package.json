{
  "name": "v9-page-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --mode preview",
    "dev:server": "node --watch --import tsx apps/server/src/index.ts",
    "build": "npm run typecheck && npm run build:web && npm run build:server && node scripts/prepare-public.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:preview": "vite build --config apps/web/vite.config.ts --mode preview",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:container": "node scripts/smoke-container.mjs",
    "start": "node dist/apps/server/src/index.js",
    "worker": "node dist/apps/server/src/worker.js",
    "db:migrate": "node --import tsx apps/server/src/migrate.ts",
    "db:migrate:production": "node dist/apps/server/src/migrate.js",
    "dev:live": "vite --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.12",
    "dotenv": "17.4.2",
    "fastify": "5.12.8",
    "lucide-react": "1.77.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
