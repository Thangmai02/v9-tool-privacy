# Copy to .env on your own server. Never commit .env or send secrets in chat.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://studio.example.com
APP_DOMAIN=studio.example.com
POSTGRES_USER=v9
POSTGRES_DB=v9
# Generate a URL-safe random password (e.g. 32 random bytes encoded as hex).
POSTGRES_PASSWORD=
# Local non-Docker development can set DATABASE_URL; Compose sets its internal URL.
DATABASE_URL=postgresql://v9:CHANGE_ME@localhost:5432/v9
META_APP_ID=
META_APP_SECRET=
# User access token configuration from Facebook Login for Business.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v27.0
# 32 random bytes, base64. Keep a secure backup: losing this key loses token access.
TOKEN_ENCRYPTION_KEY=
WORKER_CONCURRENCY=4
PAGE_INTERVAL_SECONDS=15
SESSION_TTL_DAYS=7
